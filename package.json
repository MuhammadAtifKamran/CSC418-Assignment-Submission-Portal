{
  "name": "csc418-assignment-submission-portal",
  "version": "1.0.0",
  "description": "Assignment Submission Portal with automated testing for the CSC418 DevOps Lab Midterm.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "receiver": "node receiver/receiver.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "report:build": "node scripts/build-report.js",
    "report:send": "node scripts/send-report.js",
    "report:email": "node scripts/send-email-report.js"
  },
  "keywords": [
    "devops",
    "nodejs",
    "github-actions",
    "automated-testing",
    "assignment-portal"
  ],
  "author": "Muhammad Atif Kamran",
  "license": "MIT",
  "devDependencies": {
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "clearMocks": true,
    "restoreMocks": true
  },
  "dependencies": {
    "nodemailer": "^10.3.1"
  }
}
